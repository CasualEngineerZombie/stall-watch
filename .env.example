# The only two credentials this app has.
#
# Both are public by design (they are shipped to the browser). RLS, not secrecy,
# protects the data. There is deliberately no service-role key in this project.
#
# Local Supabase (supabase start) prints the same two values; hosted Supabase has them
# in Project Settings -> API. Copy this file to .env.local and fill them in.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
